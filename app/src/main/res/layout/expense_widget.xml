<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="6dp"
    android:background="@drawable/expense_widget_background">

    <FrameLayout
        android:id="@+id/widget_main_header"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/widget_header"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_dates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026年11月"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:accessibilityTraversalAfter="@id/widget_total"/>

                    <ImageButton
                        android:id="@+id/widget_prev"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/widget_chevron_left"
                        android:background="@drawable/widget_nav_bg"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="上一周期"/>

                    <ImageButton
                        android:id="@+id/widget_next"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/widget_chevron_right"
                        android:background="@drawable/widget_nav_bg"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="下一周期"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="2026年11月"
                    android:textSize="11sp"
                    android:textColor="@color/widget_muted"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:visibility="gone"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="end|center_vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="本月花销"
                    android:textSize="11sp"
                    android:textColor="@color/widget_muted"
                    android:includeFontPadding="false"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/widget_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="end|center_vertical"
                    android:text="¥0.00"
                    android:textColor="@color/widget_total"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:singleLine="true"/>

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:src="@drawable/widget_refresh"
            android:background="@drawable/widget_refresh_bg"
            android:contentDescription="刷新花销"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/widget_muted"
        android:text="正在更新…"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/widget_chart_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:minHeight="48dp"
        android:orientation="vertical"/>

    <LinearLayout
        android:id="@+id/widget_segments"
        android:padding="0dp"
        android:layout_width="168dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/widget_segment_track">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="48dp">

            <Button
                android:id="@+id/widget_week"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="周"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/widget_muted"
                android:textStyle="normal"
                android:background="@drawable/widget_segment_normal"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone"/>

            <Button
                android:id="@+id/widget_week_selected"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="周"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_choice"
                android:textStyle="bold"
                android:background="@drawable/widget_segment_selected"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="visible"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="48dp">

            <Button
                android:id="@+id/widget_month"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="月"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/widget_muted"
                android:textStyle="normal"
                android:background="@drawable/widget_segment_normal"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="visible"/>

            <Button
                android:id="@+id/widget_month_selected"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="月"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_choice"
                android:textStyle="bold"
                android:background="@drawable/widget_segment_selected"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="48dp">

            <Button
                android:id="@+id/widget_year"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="年"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/widget_muted"
                android:textStyle="normal"
                android:background="@drawable/widget_segment_normal"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="visible"/>

            <Button
                android:id="@+id/widget_year_selected"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="年"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_choice"
                android:textStyle="bold"
                android:background="@drawable/widget_segment_selected"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone"/>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
